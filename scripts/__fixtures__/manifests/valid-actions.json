{
  "id": "sample-plugin",
  "name": "Sample",
  "version": "1.0.0",
  "description": "A sample.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "category": "Productivity",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
