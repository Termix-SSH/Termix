{
  "id": "ai",
  "name": "AI Assistant",
  "version": "1.0.0",
  "description": "An AI assistant that can read your hosts, snippets, fleets, alerts and automations, and propose changes for you to approve.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Productivity",
  "icon": "Sparkles",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "hosts:read",
    "hosts:write",
    "credentials:use",
    "ssh:connect",
    "db:own",
    "secrets:own",
    "network:outbound",
    "audit:read",
    "ui:surface"
  ],
  "dependencies": {
    "automations": "^1.0.0"
  },
  "providesSecret": [
    {
      "key": "api-key",
      "permission": "ai.secrets.share",
      "descriptionKey": "ai.secrets.shareApiKey"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "ai",
        "titleKey": "nav.ai",
        "icon": "Sparkles",
        "openFrom": ["rail", "palette"]
      }
    ],
    "actions": [
      {
        "id": "ai.openWithContext",
        "titleKey": "ai.assistant",
        "handler": "openWithContext",
        "icon": "Bot",
        "permission": "ai.services.use",
        "slot": "terminal.toolbar",
        "kind": "button"
      }
    ],
    "permissionGroup": {
      "group": "ai",
      "permissions": [
        "ai.use",
        "ai.manage_providers",
        "ai.apply_proposals",
        "ai.services.use",
        "ai.secrets.share"
      ],
      "defaultForRole": {
        "admin": ["ai.services.use"]
      }
    }
  },
  "backend": "backend/index.mjs",
  "frontend": "frontend/index.mjs",
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
