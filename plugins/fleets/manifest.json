{
  "id": "fleets",
  "name": "Fleets",
  "version": "1.0.0",
  "description": "Group hosts into fleets and run commands, package actions and file transfers on all of them at once.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Infrastructure",
  "icon": "Boxes",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "hosts:read",
    "hosts:write",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface"
  ],
  "optionalDependencies": {
    "snippets": "^1.0.0"
  },
  "provides": [
    {
      "service": "fleets.access",
      "version": "1.0.0",
      "permission": "fleets.view"
    }
  ],
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "contributes": {
    "tabs": [
      {
        "id": "fleet-inventory",
        "titleKey": "nav.fleets",
        "icon": "Boxes",
        "openFrom": ["rail"]
      }
    ],
    "panels": [
      {
        "id": "fleets",
        "titleKey": "nav.fleets",
        "icon": "Boxes"
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "manage",
        "titleKey": "permissions.manage.title",
        "descriptionKey": "permissions.manage.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "execute",
        "titleKey": "permissions.execute.title",
        "descriptionKey": "permissions.execute.description",
        "defaultRoles": ["user"]
      }
    ],
    "uses": ["snippets.extractInputs"]
  }
}
