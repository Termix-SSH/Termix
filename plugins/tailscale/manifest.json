{
  "id": "tailscale",
  "name": "Tailscale",
  "version": "1.0.0",
  "description": "Browse and connect to tailnet devices, manage the Tailscale API key, and show the Tailscale SSH re-authentication dialog.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Networking",
  "icon": "Network",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "settings:read-core",
    "network:outbound",
    "network:serve",
    "ui:surface"
  ],
  "contributes": {
    "permissionGroup": {
      "group": "tailscale",
      "permissions": ["tailscale.devices.view"]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
