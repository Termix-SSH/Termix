{
  "id": "tailscale",
  "name": "Tailscale",
  "version": "1.0.0",
  "description": "Browse and connect to tailnet devices, manage the Tailscale API key, and show the Tailscale SSH re-authentication dialog.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Networking",
  "icon": "Network",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "settings:read-core",
    "network:outbound",
    "network:serve",
    "auth:provide",
    "ssh:connect",
    "credentials:use",
    "ui:surface"
  ],
  "optionalDependencies": {
    "host-metrics": "^1.0.0"
  },
  "contributes": {
    "panels": [
      {
        "id": "tailscale",
        "titleKey": "nav.tailscale",
        "icon": "Radar"
      }
    ],
    "permissions": [
      {
        "name": "devices.view",
        "titleKey": "permissions.devices.view.title",
        "descriptionKey": "permissions.devices.view.description",
        "defaultRoles": ["admin"]
      }
    ],
    "auth": {
      "sshAuthTypes": ["tailscale"]
    },
    "settings": {
      "admin": [
        {
          "key": "apiKey",
          "type": "secret",
          "labelKey": "settings.apiKey.label",
          "descriptionKey": "settings.apiKey.description",
          "placeholderKey": "settings.apiKey.placeholder",
          "group": "settings.group.api"
        },
        {
          "key": "apiBaseUrl",
          "type": "string",
          "labelKey": "settings.apiBaseUrl.label",
          "descriptionKey": "settings.apiBaseUrl.description",
          "placeholderKey": "settings.apiBaseUrl.placeholder",
          "default": "",
          "group": "settings.group.api"
        },
        {
          "key": "devices",
          "type": "custom",
          "component": "devices",
          "group": "settings.group.devices"
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
