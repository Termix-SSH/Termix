{
  "id": "proxmox",
  "name": "Proxmox",
  "version": "1.0.0",
  "description": "Discover Proxmox VE guests over an existing SSH host, import them as Termix hosts, and keep them in sync.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Infrastructure",
  "icon": "Server",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "hosts:read",
    "hosts:write",
    "credentials:use",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "proxmox-stats",
        "titleKey": "nav.proxmoxStats",
        "icon": "HardDrive",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "settings": {
      "host": {
        "fields": [
          {
            "key": "enableProxmox",
            "type": "custom",
            "component": "proxmoxHostSettings"
          },
          {
            "key": "proxmoxConfig",
            "type": "custom",
            "component": "proxmoxHostSettings"
          },
          {
            "key": "enableProxmoxStats",
            "type": "custom",
            "component": "proxmoxHostSettings"
          },
          {
            "key": "proxmoxStatsConfig",
            "type": "custom",
            "component": "proxmoxHostSettings"
          }
        ]
      }
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
