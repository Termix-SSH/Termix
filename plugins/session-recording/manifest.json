{
  "id": "session-recording",
  "name": "Session Recording",
  "version": "1.0.0",
  "description": "Records terminal sessions and lets you play them back or download them.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Terminal",
  "icon": "ScrollText",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "hosts:read",
    "db:own",
    "files:own",
    "network:serve",
    "ui:surface"
  ],
  "provides": [
    {
      "service": "recordings.writer",
      "version": "1.0.0",
      "permission": "session-recording.view"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "session-logs",
        "titleKey": "nav.sessionLogs",
        "icon": "ScrollText",
        "openFrom": ["rail"]
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "retentionDays",
          "type": "number",
          "labelKey": "settings.admin.retentionDays.label",
          "descriptionKey": "settings.admin.retentionDays.description",
          "min": 1,
          "max": 3650,
          "default": 30
        }
      ],
      "host": {
        "enableKey": "enableSessionRecording",
        "enableLabelKey": "settings.host.enable.label",
        "fields": []
      }
    },
    "hostCapability": {
      "key": "enableSessionRecording",
      "labelKey": "hosts.enableSessionRecording",
      "editorTab": "general"
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
