{
  "id": "network-topology",
  "name": "Network Topology",
  "version": "1.0.0",
  "description": "Visualize hosts and their connections as an interactive graph, saved per user.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Infrastructure",
  "icon": "Network",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": ["db:own", "ui:surface"],
  "contributes": {
    "tabs": [
      {
        "id": "network_graph",
        "titleKey": "nav.networkGraph",
        "icon": "Network",
        "openFrom": ["rail", "palette"]
      }
    ]
  },
  "backend": "backend/index.mjs",
  "frontend": "frontend/index.mjs",
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
