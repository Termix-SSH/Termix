{
  "id": "sso",
  "name": "Single sign-on",
  "version": "1.0.0",
  "description": "Sign in with an OpenID Connect provider, GitHub or Google. Each provider you add gets its own button on the login screen.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Access & Security",
  "icon": "KeyRound",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "db:own",
    "kv:own",
    "secrets:own",
    "network:serve",
    "auth:provide",
    "ui:surface"
  ],
  "contributes": {
    "auth": {
      "loginMethods": ["oidc"]
    },
    "permissions": [
      {
        "name": "manage",
        "titleKey": "permissions.manage.title",
        "descriptionKey": "permissions.manage.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "providers",
          "type": "custom",
          "component": "providers",
          "permission": "manage"
        }
      ]
    },
    "http": {
      "legacyRedirects": [
        {
          "from": "/users/oidc-config",
          "to": "/config"
        },
        {
          "from": "/users/oidc/callback",
          "to": "/callback",
          "status": 308
        },
        {
          "from": "/users/oidc/backchannel-logout",
          "to": "/backchannel-logout",
          "status": 308
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
