{
  "id": "step-ca",
  "name": "Step CA",
  "version": "1.0.0",
  "description": "Connect to hosts with short-lived SSH certificates from a smallstep step-ca server.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Access & Security",
  "icon": "ShieldCheck",
  "engine": {
    "termix": ">=26.10.0",
    "api": "1"
  },
  "capabilities": [
    "db:own",
    "secrets:own",
    "network:outbound",
    "network:serve",
    "auth:provide",
    "ui:surface"
  ],
  "contributes": {
    "auth": {
      "sshAuthTypes": ["stepca"]
    },
    "settings": {
      "admin": [
        {
          "key": "caUrl",
          "type": "string",
          "labelKey": "settings.caUrl.label",
          "descriptionKey": "settings.caUrl.description",
          "placeholderKey": "settings.caUrl.placeholder",
          "default": ""
        },
        {
          "key": "fingerprint",
          "type": "string",
          "labelKey": "settings.fingerprint.label",
          "descriptionKey": "settings.fingerprint.description",
          "default": ""
        },
        {
          "key": "provisioner",
          "type": "string",
          "labelKey": "settings.provisioner.label",
          "descriptionKey": "settings.provisioner.description",
          "default": ""
        },
        {
          "key": "privateEndpoints",
          "type": "textarea",
          "labelKey": "settings.privateEndpoints.label",
          "descriptionKey": "settings.privateEndpoints.description",
          "default": ""
        },
        {
          "key": "redirectUri",
          "type": "custom",
          "component": "redirectUri"
        },
        {
          "key": "legacyCallback",
          "type": "boolean",
          "labelKey": "settings.legacyCallback.label",
          "descriptionKey": "settings.legacyCallback.description",
          "default": false
        }
      ]
    },
    "http": {
      "legacyRedirects": [
        {
          "from": "/host/step-ca-callback",
          "to": "/callback"
        }
      ]
    },
    "uses": ["terminal.overlay"]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
