{
  "id": "host-metrics",
  "name": "Host Metrics",
  "version": "1.0.0",
  "description": "Live CPU, memory, disk, network and process metrics, plus host management (services, packages, firewall, cron, users, SSL, logs, WireGuard, Tailscale).",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Monitoring",
  "icon": "Activity",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "db:own",
    "network:serve",
    "events:core",
    "ui:surface"
  ],
  "optionalDependencies": {
    "automations": "^1.0.0"
  },
  "contributes": {
    "tabs": [
      {
        "id": "host-metrics",
        "titleKey": "nav.hostMetrics",
        "icon": "Activity",
        "openFrom": ["host-context-menu", "palette"]
      },
      {
        "id": "proxmox-stats",
        "titleKey": "nav.proxmoxStats",
        "icon": "HardDrive",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "historyRetention",
          "type": "custom",
          "component": "retention"
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
