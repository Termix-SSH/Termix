{
  "id": "ssh-terminal",
  "name": "SSH Terminal",
  "version": "1.0.0",
  "description": "Interactive SSH terminal sessions, with jump hosts, host key verification and session sharing.",
  "author": {
    "name": "Termix"
  },
  "license": "MIT",
  "repository": "https://github.com/Termix-SSH/Termix",
  "category": "Terminal",
  "icon": "SquareTerminal",
  "engine": {
    "termix": ">=2.9.0",
    "api": "1"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "network:serve",
    "ui:surface"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "terminal",
        "titleKey": "nav.terminal",
        "icon": "SquareTerminal",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "actionSlots": [
      {
        "id": "terminal.toolbar",
        "accepts": ["button"]
      },
      {
        "id": "terminal.dock",
        "accepts": ["component"]
      },
      {
        "id": "terminal.overlay",
        "accepts": ["component"]
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
