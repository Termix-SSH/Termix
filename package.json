{
  "name": "termix",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "26.11.3",
  "description": "Self-hosted, plugin-based server management.",
  "author": "Karmaa",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/patch-app-builder-lib.cjs && node scripts/patch-better-sqlite3.cjs && node scripts/patch-nan.cjs && node scripts/patch-node-pty.cjs && node scripts/patch-ssh2-agent.cjs && node scripts/patch-ssh2-sk.cjs && node scripts/patch-sigstore-verify.cjs",
    "ci:install": "npm ci --ignore-scripts --no-audit --no-fund && npm run postinstall && node scripts/drop-cpu-features.cjs && npm rebuild node-pty",
    "recover": "node dist/backend/recovery/cli.js",
    "sbom": "cyclonedx-npm --omit dev --package-lock-only --ignore-npm-errors --output-reproducible --output-format JSON --output-file sbom.cdx.json",
    "prepare": "husky || true",
    "prebuild": "node scripts/write-electron-build-info.cjs",
    "lint": "node scripts/generate-dialect-schema.cjs --check && eslint . && node scripts/check-importmap-csp.cjs && node scripts/check-core-plugin-ids.cjs && node scripts/check-sdk-ui-exports.cjs && node scripts/check-button-colors.cjs && node scripts/check-sdk-guide.cjs && node scripts/check-test-locations.cjs && node scripts/check-changelog.cjs && node scripts/check-env-catalog.cjs && node scripts/check-workflow-secrets.cjs && node scripts/check-plugin-node.cjs",
    "lint:fix": "eslint --fix .",
    "type-check": "npm run build:sdk && tsc -b --force",
    "test": "vitest run",
    "verify:dialect": "tsx scripts/verify-dialects.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:authz": "node scripts/authz/run.mjs",
    "test:hostile": "node scripts/hostile/run.mjs",
    "hostile:ui": "vite build --outDir node_modules/hostile-ui --emptyOutDir && vite build -c vite.frame.config.ts --outDir node_modules/hostile-ui/frame --emptyOutDir",
    "dev": "node scripts/dev.mjs",
    "dev:electron": "node scripts/dev.mjs electron",
    "plugin-runtime": "node scripts/build-plugin-runtime.cjs",
    "dev:docker": "node scripts/dev.mjs docker",
    "dev:frontend": "vite",
    "build": "npm run build:sdk && vite build && npm run build:frame && node scripts/stamp-sw-build-info.cjs && tsc -p tsconfig.node.json && node -e \"require('fs').copyFileSync('src/backend/package.json','dist/backend/package.json')\" && npm run build:plugins",
    "build:backend:core": "npm run build:sdk && tsc -p tsconfig.node.json && node -e \"require('fs').copyFileSync('src/backend/package.json','dist/backend/package.json')\" && node scripts/generate-openapi.mjs dist/backend/openapi.json",
    "build:backend": "npm run build:backend:core && npm run build:plugins",
    "generate:openapi": "npm run build:sdk && node scripts/generate-openapi.mjs",
    "electron:rebuild": "electron-rebuild -f -o better-sqlite3,@serialport/bindings-cpp,node-pty",
    "build:win-portable": "npm run build && npm run electron:rebuild && electron-builder --win --dir",
    "build:win-installer": "npm run build && npm run electron:rebuild && electron-builder --win --publish=never",
    "build:linux-appimage": "npm run build && npm run electron:rebuild && electron-builder --linux AppImage",
    "build:linux-targz": "npm run build && npm run electron:rebuild && electron-builder --linux tar.gz",
    "build:mac": "npm run build && npm run electron:rebuild && electron-builder --mac --universal",
    "schema:generate": "node scripts/generate-dialect-schema.cjs",
    "schema:check": "node scripts/generate-dialect-schema.cjs --check",
    "schema:migrations": "drizzle-kit generate --config=drizzle.config.sqlite.ts && drizzle-kit generate --config=drizzle.config.pg.ts && drizzle-kit generate --config=drizzle.config.mysql.ts",
    "build:sdk": "npm run build --workspace @termix-ssh/plugin-sdk && node scripts/build-sdk-host.mjs",
    "build:plugins": "node scripts/build-plugins.cjs",
    "build:frame": "vite build -c vite.frame.config.ts",
    "plugins:pin": "node scripts/pin-bundled-plugins.cjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@sigstore/bundle": "^5.0.1",
    "@sigstore/tuf": "^5.0.1",
    "@sigstore/verify": "^4.1.3",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/compression": "^1.8.1",
    "@types/semver": "^7.8.0",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "body-parser": "^2.4.0",
    "chalk": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "motion": "^14.14.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "semver": "^7.8.6",
    "serialport": "^13.0.0",
    "sharp": "^0.35.4",
    "socks": "^2.8.10",
    "ssh2": "^1.17.0",
    "sshpk": "^1.18.0",
    "tar": "^7.5.22",
    "undici": "^8.12.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.0",
    "@cyclonedx/cyclonedx-npm": "7.0.1",
    "@deadendjs/swagger-jsdoc": "^8.1.2",
    "@electron/notarize": "^3.1.2",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@peculiar/x509": "^3.1.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.6",
    "@types/sshpk": "^1.17.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "c8": "12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "lucide-react": "^1.73.0",
    "playwright": "^1.65.1",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "3.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.14",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.8",
    "supertest": "^7.3.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@electron/asar": "^4.2.0",
    "@electron/get": "^5.0.0",
    "dompurify": "^3.4.1",
    "eslint-visitor-keys": "^4.2.1",
    "prebuild-install": "npm:@mmomtchev/prebuild-install@1.0.2",
    "rimraf": "file:vendor/rimraf-compat",
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.9",
    "esbuild": "^0.28.1",
    "fast-uri@3": "^3.1.9",
    "ip-address": "^10.7.4",
    "js-yaml@4": "^4.3.2",
    "nanoid@3": "^3.3.18",
    "postcss": "^8.5.26",
    "tar": "$tar",
    "undici@6": "^6.29.1",
    "undici@7": "^7.30.1",
    "@xmldom/xmldom": "^0.8.15",
    "browserslist": "^4.28.7",
    "qs": "^6.16.1",
    "glob@12": "^14.0.4",
    "glob@13": "^14.0.4",
    "minimatch@9": "^11.0.5",
    "minimatch@10": "^11.0.5"
  },
  "optionalDependencies": {
    "dmg-license": "1.0.11"
  }
}
