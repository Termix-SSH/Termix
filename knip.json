{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/main.tsx",
        "src/backend/starter.ts",
        "src/backend/utils/swagger.ts",
        "src/ui/plugin-host/sdk-ui.ts",
        "src/ui/plugin-host/testing-host.tsx",
        "src/**/tests/**/*.{ts,tsx}",
        "scripts/**/*.{cjs,mjs}",
        "electron/main.cjs",
        "electron/preload.js",
        "vitest.config.ts",
        "vitest.setup.ts",
        "vite.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.cjs",
        "scripts/**/*.{cjs,mjs}"
      ],
      "ignoreBinaries": ["powershell"],
      "ignoreDependencies": [
        "@codemirror/theme-one-dark",
        "@codemirror/view",
        "@electron/notarize",
        "@radix-ui/react-alert-dialog",
        "@radix-ui/react-checkbox",
        "@radix-ui/react-label",
        "@radix-ui/react-popover",
        "@radix-ui/react-scroll-area",
        "@radix-ui/react-select",
        "@radix-ui/react-slider",
        "@radix-ui/react-slot",
        "@radix-ui/react-switch",
        "@radix-ui/react-tabs",
        "@types/better-sqlite3",
        "@types/cookie-parser",
        "@types/cors",
        "@types/express",
        "@types/jsonwebtoken",
        "@types/multer",
        "@types/ssh2",
        "@uiw/react-codemirror",
        "@xterm/addon-clipboard",
        "axios",
        "bcryptjs",
        "better-sqlite3",
        "body-parser",
        "chalk",
        "class-variance-authority",
        "clsx",
        "cmdk",
        "cookie-parser",
        "cors",
        "drizzle-orm",
        "express",
        "jsonwebtoken",
        "multer",
        "nanoid",
        "i18next-browser-languagedetector",
        "lucide-react",
        "motion",
        "radix-ui",
        "socks",
        "ssh2",
        "undici",
        "husky",
        "sharp",
        "sonner",
        "tailwind-merge"
      ]
    },
    "packages/plugin-sdk": {
      "entry": ["src/*.ts", "src/testing/*.ts", "cli/**/*.mjs"],
      "project": ["src/**/*.ts", "cli/**/*.mjs"]
    },
    "plugins/*": {
      "entry": [
        "src/backend/index.ts",
        "src/frontend/index.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    }
  }
}
