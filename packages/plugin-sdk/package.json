{
  "name": "@termix/plugin-sdk",
  "version": "1.0.0",
  "description": "The contract between Termix core and a plugin: types, the capability catalog and the manifest schema.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "termix-plugin": "./cli/index.mjs"
  },
  "exports": {
    "./backend": {
      "types": "./dist/backend.d.ts",
      "default": "./dist/backend.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./ddl": {
      "types": "./dist/ddl.d.ts",
      "default": "./dist/ddl.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "default": "./dist/frontend.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./dist/capabilities.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./testing/setup": {
      "types": "./dist/testing/setup.d.ts",
      "default": "./dist/testing/setup.js"
    },
    "./vitest-preset": {
      "types": "./dist/vitest-preset.d.ts",
      "default": "./dist/vitest-preset.js"
    },
    "./tsconfig.plugin.json": "./tsconfig.plugin.json",
    "./schema/manifest.schema.json": "./schema/manifest.schema.json"
  },
  "files": [
    "dist",
    "cli",
    "schema",
    "tsconfig.plugin.json",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "semver": "^7.6.3",
    "tar": "^7.5.22"
  }
}
